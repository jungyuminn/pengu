{
  "name": "pengu",
  "productName": "Pengu",
  "version": "0.1.0",
  "description": "ARAM Mayhem augment grade overlay",
  "main": "dist/presentation/main/index.js",
  "scripts": {
    "build": "node scripts/bundle-skill-icons.js && node scripts/bundle-spell-icons.js && node scripts/bundle-champion-icons.js && node scripts/bundle-item-icons.js && node scripts/bundle-augment-icons.js && node scripts/bundle-augment-descriptions.js && tsc && node scripts/copy-static.js",
    "start": "chcp 65001 >NUL & tsc && node scripts/copy-static.js && electron . --enable-logging",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pngjs": "^6.0.5",
    "electron": "^33.2.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@gutenye/ocr-node": "^1.4.9",
    "koffi": "^3.3.8",
    "pngjs": "^7.0.0",
    "screenshot-desktop": "^1.15.1"
  }
}
